        "essentialcraft5:fire_drops_cluster",
        "essentialcraft5:water_drops_cluster",
        "essentialcraft5:earth_drops_cluster",
        "essentialcraft5:air_drops_cluster"
      ],
      "blocks": [
        {
          "type": "p",
          "text": "<em>另一條路</em>：把一樣原版物品丟到擺好的方塊上，那一格會凝出一塊<em>魔晶簇</em>，敲碎它就得到魔晶，四種元素各有一種儀式。"
        },
        {
          "type": "table",
          "header": [
            "元素",
            "中間",
            "東西南北四格",
            "丟什麼"
          ],
          "widths": [
            1,
            3,
            3,
            3
          ],
          "rows": [
            [
              "火",
              "{block:minecraft:netherrack}",
              "{block:minecraft:lava}，流動的也算",
              "{item:minecraft:blaze_powder}"
            ],
            [
              "水",
