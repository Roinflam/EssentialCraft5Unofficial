      "items": [
        "essentialcraft5:fire_drops",
        "essentialcraft5:water_drops",
        "essentialcraft5:earth_drops",
        "essentialcraft5:air_drops",
        "essentialcraft5:elemental_infused_ore",
        "essentialcraft5:fire_infused_ore",
        "essentialcraft5:water_infused_ore",
        "essentialcraft5:earth_infused_ore",
        "essentialcraft5:air_infused_ore",
        "essentialcraft5:nether_elemental_infused_ore",
        "essentialcraft5:nether_fire_infused_ore",
        "essentialcraft5:nether_water_infused_ore",
        "essentialcraft5:nether_earth_infused_ore",
        "essentialcraft5:nether_air_infused_ore",
        "essentialcraft5:end_elemental_infused_ore",
