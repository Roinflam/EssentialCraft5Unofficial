      "blocks": [
        {
          "type": "p",
          "text": "<em>Goal</em> (optional): craft the other 15 patterns from Big Tiles. Every base follows the same tree with its own blocks. The recipes below use the \"MRU\" tiles chiseled from Magical Slag as the example."
        },
        {
          "type": "table",
          "header": [
            "Pattern",
            "Recipe",
            "Makes"
          ],
          "rows": [
            [
              "Big Tile",
              "base + chisel (shapeless)",
              "4"
            ],
            [
              "Ancient Big Tile",
              "4 Big Tiles in the four corners",
              "4"
            ],
            [
              "Brick",
              "2×2 Big Tiles",
              "4"
            ],
            [
              "Fancy Tile",
              "3×3 Big Tiles",
              "9"
            ],
            [
              "Tiles",
              "4 Bricks on the top, bottom, left and right, middle empty",
              "4"
            ],
            [
              "Pressure Plate Tile",
              "8 Bricks in a ring (middle empty)",
              "8"
            ],
            [
              "Small Tiles",
              "2×2 Tiles",
              "4"
            ],
            [
              "Creepy",
              "Big Tiles on the top and bottom rows; middle row Fancy Tile, Ancient Big Tile, Fancy Tile",
              "9"
            ],
            [
              "Futuristic Tile",
              "4 Ancient Big Tiles in a diamond, 1 Fancy Tile in the middle",
              "4"
            ],
            [
              "Tile With Gear",
              "8 Futuristic Tiles around 1 {item:minecraft:redstone}",
              "8"
            ],
            [
              "Runic Tile",
              "8 Big Tiles around 1 {item:essentialcraft5:magical_essence}",
              "8"
            ],
            [
              "Star Tile",
              "8 Big Tiles around 1 {item:essentialcraft5:mru_shard}",
              "8"
            ],
            [
              "Plated Tile",
              "8 Big Tiles around 1 {item:minecraft:iron_ingot}",
              "8"
            ],
            [
              "Packet Plated Tile",
              "8 Big Tiles around 1 {item:minecraft:leather}",
              "8"
            ],
            [
              "Double Packet Plated Tile",
              "2×2 Packet Plated Tiles",
              "4"
            ],
            [
              "Tile With Gem",
              "2×2 Plated Tiles",
              "4"
            ]
          ],
          "widths": [
            2,
            5,
            1
          ]
        },
        {
          "type": "recipe",
          "items": [
            "essentialcraft5:fancy_mru_ancient_tile",
            "essentialcraft5:fancy_mru_big_tile",
            "essentialcraft5:fancy_mru_brick",
            "essentialcraft5:fancy_mru_fancy_tile",
            "essentialcraft5:fancy_mru_pressured_tile",
            "essentialcraft5:fancy_mru_small_tiles",
