{
  "multipart": [
    {
      "apply": {
        "model": "essentialcraft5:block/reactor_support_bottom"
      },
      "when": {
        "layer": "bottom"
      }
    },
    {
      "apply": {
        "model": "essentialcraft5:block/reactor_support_middle"
      },
      "when": {
        "layer": "middle"
      }
    },
    {
      "apply": {
        "model": "essentialcraft5:block/reactor_support_top"
      },
      "when": {
        "layer": "top"
      }
    },
    {
      "apply": {
        "model": "essentialcraft5:block/reactor_support_bars"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "essentialcraft5:block/reactor_support_bars",
        "uvlock": true,
        "y": 90
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "essentialcraft5:block/reactor_support_bars",
        "uvlock": true,
        "y": 180
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "essentialcraft5:block/reactor_support_bars",
        "uvlock": true,
        "y": 270
      },
      "when": {
        "west": "true"
      }
    }
  ]
}